# appwheel config  —  ~/.config/appwheel/config
# One key=value per line. '#' starts a comment. Blank lines are ignored.
# Every key here also works on the command line (key=value or --key=value);
# command-line values win over the file. See `appwheel --help` for the full list.
# The values below are the built-in defaults, so this file changes nothing
# until you edit it.

# --- window ---
width=900
height=900
fullscreen=1     # cover the screen as a borderless overlay (0 = 900x900 window)
close_on_focus_loss=0   # 1 = quit when the window loses focus (dmenu-style)

# --- ring layout & paging ---
slots=11          # wide, easy-to-hit slots across the TOP arc
arc=240           # degrees of the ring used for apps (rest = paging zone)
radius=0.44       # wheel size, as a fraction of the shorter screen side
y_offset=0.10     # nudge the wheel down (apps sit up top, so this centers it)
page_ms=110       # base ms per paged step at the SLOW end. Bigger = calmer
                  # start. Paging eases in: slow where you enter the bottom
                  # zone, fast toward straight-down.

# --- rendering ---
ssaa=2            # full-scene supersampling 1..4 (smooths edges). alias: aa
animate=1         # subtle settle animation when the search results change
anim_ms=90        # its duration (0 or animate=0 to turn it off)
icons=1           # show .desktop icons if found (PNG/SVG/JPG/BMP)
icon_px=46        # icon size (before ui_scale)

# --- text ---
ui_scale=1.0      # master text size. 1.3 = bigger, 0.85 = smaller.
                  # aliases: font_scale, text_scale
label_px=24       # app labels on the wheel   (all four are multiplied by
title_px=25       # selected app name (center)  ui_scale, so tweak one or all)
search_px=20      # the text you type (search box)
count_px=20       # the "3 / 42" counter
# By default appwheel uses your desktop's configured font (via fontconfig).
# Set a .ttf path or a family name to override, e.g. font=JetBrains Mono
# font=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf
font_px=50        # glyph atlas height; the sharpness ceiling for big text

# --- launching / ordering ---
# appwheel logs every app you launch to the history file below and shows the
# most-recently-opened ones first. This is the default (sort=recent).
sort=recent       # recent = most-recently-opened first (DEFAULT) | alpha = A-Z
launcher=sh       # sh = run Exec= ; gtk-launch = launch by desktop id
terminal=xterm    # used for Terminal=true entries when launcher=sh
# history=~/.cache/appwheel/history   # the opened-apps log (auto-created)

# which apps show / in what order (an id is the .desktop filename without
# the extension; run `appwheel --list` to see them):
# dirs=~/.local/share/applications:/usr/share/applications
# include=firefox,code,gimp     # show ONLY these ids, in this exact order
# exclude=htop,xterm            # hide these (matches id OR Name)

# --- colors: #rrggbb or #rrggbbaa ---
# bg alpha < ff => transparent window background (needs a compositor)
bg=0d111700
ring=1e2733f2
ring2=26313ff2
hl=cb9b00ff        # highlighted slot
text=e8e8e8ff      # normal slot text
hltext=141414ff    # text on the highlighted slot
center=0d1117e6    # hub disc (keep some alpha so search text stays legible)
accent=89afc4ff    # typed query text + active paging chevrons
dim=5a6b7aff       # hints / counters / idle chevrons
